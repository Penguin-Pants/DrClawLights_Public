# --- Required (secrets — keep these in the environment) ---

# Password for the admin dashboard login. The dashboard is on the public
# internet, so use a long random value. When unset, nobody can log in.
ADMIN_PASSWORD=

# API key from https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- AI features (optional) ---

# Anthropic API key — enables the cross-book Echo section in each email
# Get one at https://console.anthropic.com
# When unset, the service runs exactly as before (no echo section)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Editable from the dashboard (no need to set these here) ---
# These env vars only SEED the initial values on first run; afterwards they
# are managed in the UI and stored in /data/config.json. Uncomment only the
# ones you want to seed.

# Verified sender address configured in your Resend account
# FROM_EMAIL=highlights@yourdomain.com

# Email address that will receive the daily digest
# RECIPIENT_EMAIL=you@example.com

# Number of books to include in each email
# BOOKS_PER_EMAIL=2

# Number of highlights to pick from each book
# HIGHLIGHTS_PER_BOOK=3

# Default timezone for the daily send schedule
# TIMEZONE=Europe/Berlin

# --- Optional path overrides (defaults shown) ---

# Files on the Railway volume. For local development, point them at a local
# directory instead.
# HIGHLIGHTS_FILE=/data/highlights.json
# HISTORY_FILE=/data/history.json
# CONFIG_FILE=/data/config.json
# DESIGN_FILE=/data/design.md
